{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/agent-manifest/v1alpha1.json",
  "title": "AgentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agentfactory.io/v1alpha1"},
    "kind": {"const": "AgentManifest"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 1}]}
      }
    },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
        "version": {"type": "string", "minLength": 1},
        "overrides": {
          "type": "object",
          "description": "Only keys declared overrideable by the Capability Registry record are valid at compile time.",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "requiredCapabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "version"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"},
        "version": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean", "default": false},
        "overrides": {
          "type": "object",
          "description": "Only keys declared overrideable by the Capability Registry record are valid at compile time.",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "requires"],
      "properties": {
        "provides": {"type": "array", "items": {"$ref": "#/$defs/capabilityRef"}, "default": []},
        "requires": {"type": "array", "items": {"$ref": "#/$defs/requiredCapabilityRef"}, "default": []}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "capabilities", "tools", "permissions", "memoryProfile", "budgetProfile", "evalProfile"],
      "properties": {
        "template": {"$ref": "#/$defs/templateRef"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "tools": {"$ref": "#/$defs/tools"},
        "permissions": {"$ref": "#/$defs/permissions"},
        "memoryProfile": {"type": "string", "minLength": 1},
        "budgetProfile": {"type": "string", "minLength": 1},
        "evalProfile": {"type": "string", "minLength": 1}
      }
    }
  }
}
