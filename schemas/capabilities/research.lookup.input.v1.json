{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/capabilities/research.lookup.input.v1.json",
  "title": "research.lookup v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "purpose"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic task purpose only; this field never grants runtime authority."
    },
    "freshness": {
      "enum": ["any", "recent", "current"],
      "default": "any"
    },
    "maxEvidenceItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 8
    }
  }
}
