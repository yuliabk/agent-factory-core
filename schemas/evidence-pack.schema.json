{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/evidence-pack/v1alpha1.json",
  "title": "EvidencePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "evidencePackId", "releaseId", "specRef", "agentManifestRef",
    "clientInstanceConfigRef", "effectiveReleaseConfigRef", "platformPolicyRef",
    "exceptionPolicyRefs", "templateModuleRefs", "configDiffRef", "providerProfile",
    "capabilityToolContractRefs", "evalResultRefs", "releaseDecisionRef",
    "knownLimitations", "rollbackRef", "createdAt"
  ],
  "properties": {
    "apiVersion": {"const": "agentfactory.io/v1alpha1"},
    "kind": {"const": "EvidencePack"},
    "evidencePackId": {"type": "string", "minLength": 1},
    "releaseId": {"type": "string", "minLength": 1},
    "specRef": {"type": "string", "minLength": 1},
    "agentManifestRef": {"type": "string", "minLength": 1},
    "clientInstanceConfigRef": {"type": "string", "minLength": 1},
    "effectiveReleaseConfigRef": {"type": "string", "minLength": 1},
    "platformPolicyRef": {"type": "string", "minLength": 1},
    "exceptionPolicyRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "templateModuleRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "configDiffRef": {"type": "string", "minLength": 1},
    "providerProfile": {"type": "string", "minLength": 1},
    "capabilityToolContractRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evalResultRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "releaseDecisionRef": {"type": "string", "minLength": 1},
    "knownLimitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rollbackRef": {"type": ["string", "null"], "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
