{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/release-decision-record/v1alpha1.json",
  "title": "ReleaseDecisionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "releaseDecisionId", "releaseId", "platformPolicyRef",
    "exceptionPolicyRefs", "strategy", "result", "blockingCheckRefs", "warningCheckRefs",
    "advisoryCheckRefs", "evalResultRefs", "approvalRef", "reason", "timestamp"
  ],
  "properties": {
    "apiVersion": {"const": "agentfactory.io/v1alpha1"},
    "kind": {"const": "ReleaseDecisionRecord"},
    "releaseDecisionId": {"type": "string", "minLength": 1},
    "releaseId": {"type": "string", "minLength": 1},
    "platformPolicyRef": {"type": "string", "minLength": 1},
    "exceptionPolicyRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "strategy": {"enum": ["policy-auto", "human-required"]},
    "result": {"enum": ["released", "blocked", "pending-approval"]},
    "blockingCheckRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "warningCheckRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "advisoryCheckRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evalResultRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "approvalRef": {"type": ["string", "null"], "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
