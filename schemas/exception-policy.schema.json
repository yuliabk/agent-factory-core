{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/exception-policy/v1alpha1.json",
  "title": "ExceptionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agentfactory.io/v1alpha1"},
    "kind": {"const": "ExceptionPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformPolicyRef", "scope", "reason", "approver", "expiresAt", "allow"],
      "properties": {
        "platformPolicyRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "environment"],
          "properties": {
            "tenantId": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "agentName": {"type": ["string", "null"], "minLength": 1},
            "agentVersion": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "expiresAt": {"type": "string", "format": "date-time"},
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permissions", "providerProfiles", "budgetOverrideKeys", "memoryConfigKeys"],
          "properties": {
            "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "providerProfiles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "budgetOverrideKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "memoryConfigKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        }
      }
    }
  }
}
