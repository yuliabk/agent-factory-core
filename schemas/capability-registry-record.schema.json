{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/capability-registry-record/v1alpha1.json",
  "title": "CapabilityRegistryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "version",
    "inputSchemaRef",
    "outputSchemaRef",
    "riskClass",
    "costClass",
    "allowedDataClassifications"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {"type": "string", "minLength": 1},
    "inputSchemaRef": {"type": "string", "minLength": 1},
    "outputSchemaRef": {"type": "string", "minLength": 1},
    "riskClass": {"type": "string", "minLength": 1},
    "costClass": {"type": "string", "minLength": 1},
    "allowedDataClassifications": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "environments": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "requiredPermissions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "overrideable": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": true
      },
      "default": {}
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "environments": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          },
          "enabled": {"type": "boolean", "default": true},
          "transport": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["type", "endpointRef", "path", "auth", "timeoutSeconds"],
            "properties": {
              "type": {"const": "http-json"},
              "endpointRef": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1, "pattern": "^/"},
              "auth": {"const": "bearer"},
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30}
            }
          }
        }
      },
      "default": []
    }
  }
}
