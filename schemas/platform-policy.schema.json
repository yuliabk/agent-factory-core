{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfactory.io/schemas/platform-policy/v1alpha1.json",
  "title": "PlatformPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agentfactory.io/v1alpha1"},
    "kind": {"const": "PlatformPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPermissions", "deniedPermissions", "allowedProviderProfiles",
        "allowedBudgetOverrideKeys", "allowedMemoryConfigKeys", "registryMode",
        "defaultDataClassification", "exceptionAllowances"
      ],
      "properties": {
        "allowedPermissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deniedPermissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowedProviderProfiles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowedBudgetOverrideKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "allowedMemoryConfigKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "registryMode": {"enum": ["soft", "strict"]},
        "defaultDataClassification": {"type": "string", "minLength": 1},
        "exceptionAllowances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permissions", "providerProfiles", "budgetOverrideKeys", "memoryConfigKeys"],
          "properties": {
            "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "providerProfiles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "budgetOverrideKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "memoryConfigKeys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        }
      }
    }
  }
}
