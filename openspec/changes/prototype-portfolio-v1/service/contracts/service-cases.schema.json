{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-factory:pf-s:service-cases:1.0.0",
  "title": "PF-S Synthetic Service Cases",
  "type": "array",
  "minItems": 6,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "version", "tenant_id", "classification", "category", "summary_he", "required_fields", "approved_source_ids"],
    "properties": {
      "case_id": {"type": "string", "pattern": "^CS-C[0-9]{2}$"},
      "version": {"const": "1.0.0"},
      "tenant_id": {"const": "af-demo-retail"},
      "classification": {"const": "synthetic"},
      "category": {"type": "string", "enum": ["product_policy", "delivery_policy", "warranty_policy", "unsupported", "protected_action"]},
      "summary_he": {"type": "string", "minLength": 1},
      "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["item_id", "demo_zone", "submitted_time"]}},
      "approved_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["CSR-001", "CSR-002", "CSR-003", "CSR-004"]}}
    }
  }
}
