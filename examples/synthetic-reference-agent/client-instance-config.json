{
  "apiVersion": "agentfactory.io/v1alpha1",
  "kind": "ClientInstanceConfig",
  "metadata": {
    "name": "synthetic-reference-instance",
    "environment": "sandbox"
  },
  "spec": {
    "agentRef": {
      "name": "synthetic-reference-agent",
      "version": "0.1.0"
    },
    "tenant": {
      "id": "tenant-synthetic"
    },
    "variables": {},
    "trustProfile": "internal",
    "releaseStrategy": "policy-auto",
    "providerProfile": "balanced",
    "secretsRef": {},
    "memoryConfig": {
      "allowedClasses": ["session", "task_working"],
      "allowedPurposes": ["conversation", "task"],
      "allowedRetentionProfiles": ["session", "task"],
      "readEnabled": true,
      "writeEnabled": true,
      "minimumTrustProfile": "internal"
    },
    "budgetOverrides": {},
    "permissionOverrides": {
      "allow": [
        "capability.synthetic.invoke",
        "memory.read",
        "memory.write",
        "model.invoke",
        "synthetic.lookup"
      ],
      "deny": []
    },
    "toolBindings": {
      "synthetic.lookup": "tool.synthetic.lookup.v1"
    }
  }
}
